<link rel="stylesheet" href="/stylesheets/style.css">
<div class="page">
  <header class="top">
    <h1>Lab I - Books CRUD</h1>
    <p>Nazar Kopachynskyi 57708</p>
  </header>

  <main class="content">
    <div class="card form-card">
      <h2>Create new book</h2>

      <form method="post" action="/book/create" class="form">
        <label>Title</label>
        <input type="text" name="title" required>

        <label>Author</label>
        <input type="text" name="author" required>

        <label>Description</label>
        <textarea name="description" required></textarea>

        <div class="buttons">
          <button class="btn btn-primary" type="submit">Save</button>
          <a class="btn" href="/book">Back to list</a>
        </div>
      </form>
    </div>
  </main>

  <footer class="footer">
    <p>PTW LAB I</p>
  </footer>
</div>